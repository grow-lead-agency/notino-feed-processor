# notino-feed-processor crontab (supercronic)
#
# AGGRESSIVE CONFIG — utilizing CPX62 (16 cores, 32 GB RAM)
# Plain HTTP jobs run frequently (free), Firecrawl stays conservative (paid).
#
# Queue architecture:
#   Scheduler (every 15 min) → Redis queue → 4 parallel Workers (continuous)
#   Stalled job recovery built into both scheduler + worker
#   Delayed job promotion built into both scheduler + worker

# ── SCHEDULER ──────────────────────────────────────────────────────
# Check shop_scrape_config for due jobs, enqueue to Redis (every 15 min)
*/15 * * * * python /app/jobs/job_queue.py schedule >> /proc/1/fd/1 2>&1

# ── QUEUE WORKERS ──────────────────────────────────────────────────
# Worker launcher reads desired_workers from pipeline_config DB table.
# Spawns/kills workers to match target. flock prevents duplicate launcher.
0 * * * * flock -n /tmp/worker_launcher.lock python /app/jobs/worker_launcher.py >> /proc/1/fd/1 2>&1

# ── PLAIN HTTP JOBS (free, run often) ──────────────────────────────

# Sitemap XML feeds v1 — DEPRECATED (kept for backward compat, will be removed)
# 0 */2 * * * python /app/jobs/sitemap_crawler.py >> /proc/1/fd/1 2>&1

# Sitemap Crawler v2 — universal URL discovery (ALL types: product, category, brand, blog, page, image)
# Also writes product URLs to v1 queue for backward compat with jsonld_scraper
# TEMP: every hour at :20 for initial data fill, then switch back to 0 */2
20 * * * * flock -n /tmp/sitemap_crawler_v2.lock python /app/jobs/sitemap_crawler_v2.py >> /proc/1/fd/1 2>&1

# Hlídač Shopů API — every 4 hours (was 6h). CZ/SK price history.
# Runs 2 flows: (1) price sync for CZ/SK hard/blocked shops → product_offers + offer_price_history,
# (2) original enrichment → hlidac_shopu_data. Free alternative to Firecrawl for hard shops.
30 */4 * * * python /app/jobs/hlidac_shopu.py >> /proc/1/fd/1 2>&1

# ── FIRECRAWL JOBS (paid, keep conservative) ───────────────────────

# Firecrawl — hard/blocked shops, 2× daily. Budget: ~$40/day max.
# ONLY job still using Firecrawl cloud (needs Fire-engine anti-bot).
0 3,15 * * * python /app/jobs/firecrawl_scraper.py >> /proc/1/fd/1 2>&1

# ── SHOP CLASSIFICATION & DISCOVERY ───────────────────────────────

# Access tier classifier — daily 2 AM, batch 100. Waterfall: http→crawl4ai→firecrawl→blocked.
0 2 * * * flock -n /tmp/access_classifier.lock python /app/jobs/access_classifier.py >> /proc/1/fd/1 2>&1

# Shop page discovery — every 6h at :00, batch 100. Scans homepage for shipping/legal/returns/about/contact/FAQ.
# Populates discovered_*_url columns on shops — used by shipping/legal scrapers as fast path.
0 */6 * * * flock -n /tmp/shop_discovery.lock python /app/jobs/shop_discovery.py >> /proc/1/fd/1 2>&1

# ── CRAWL4AI JOBS (self-hosted, Firecrawl fallback) ───────────────

# Shipping scraper — every 6h at :15, batch 50. Uses discovered_shipping_url if available.
15 */6 * * * flock -n /tmp/shipping_scraper.lock python /app/jobs/shipping_scraper.py >> /proc/1/fd/1 2>&1

# Legal entity scraper — every 6h at :45, batch 50. Uses discovered_legal_url if available.
45 */6 * * * flock -n /tmp/legal_scraper.lock python /app/jobs/legal_scraper.py >> /proc/1/fd/1 2>&1

# ── SITEMAP URL TYPE SCRAPERS (dequeue from url_discovery_queue) ───

# Brand page scraper — (Crawl4AI + HTTP fallback)
# Dequeues url_type='brand' → shop_brand_pages, auto-matches to brands master
# TEMP: every hour at :35 for initial data fill, then switch to 30 */2
35 * * * * flock -n /tmp/brand_page_scraper.lock python /app/jobs/brand_page_scraper.py >> /proc/1/fd/1 2>&1

# Blog/article scraper — (Crawl4AI + HTTP fallback)
# Dequeues url_type='blog' → shop_blog_articles (topics, brand mentions, sentiment)
# TEMP: every hour at :40 for initial data fill, then switch to 0 */6
40 * * * * flock -n /tmp/blog_scraper.lock python /app/jobs/blog_scraper.py >> /proc/1/fd/1 2>&1

# CMS page scraper — (plain HTTP, shallow meta extraction)
# Dequeues url_type='page' → shop_pages, classifies + routes to domain tables
# TEMP: every hour at :45 for initial data fill, then switch to 15 */4
45 * * * * flock -n /tmp/cms_page_scraper.lock python /app/jobs/cms_page_scraper.py >> /proc/1/fd/1 2>&1

# ── ENRICHMENT JOBS (DB-only, free) ────────────────────────────────

# Offer enrichment — batch SQL updates, every 6h after new data lands
30 */6 * * * flock -n /tmp/offer_enricher.lock python /app/jobs/offer_enricher.py >> /proc/1/fd/1 2>&1

# Keyword extraction — daily at 5 AM (after overnight scraping)
0 5 * * * flock -n /tmp/keyword_extractor.lock python /app/jobs/keyword_extractor.py >> /proc/1/fd/1 2>&1

# ── CATEGORY & SEO PIPELINE (daily chain: categories → mapping → products → landing pages) ──
# Category tree scraper — daily at 4 AM, batch 30 shops
0 4 * * * flock -n /tmp/category_tree.lock python /app/jobs/category_tree_scraper.py >> /proc/1/fd/1 2>&1

# Category mapper — daily at 4:30 AM (after category tree)
30 4 * * * flock -n /tmp/category_mapper.lock python /app/jobs/category_mapper.py >> /proc/1/fd/1 2>&1

# Product categorizer — daily at 5:30 AM (after mapper + keyword extractor)
30 5 * * * flock -n /tmp/product_categorizer.lock python /app/jobs/product_categorizer.py >> /proc/1/fd/1 2>&1

# SEO landing page generator — daily at 6 AM (after categorizer)
0 6 * * * flock -n /tmp/seo_landing.lock python /app/jobs/seo_landing_generator.py >> /proc/1/fd/1 2>&1

# Sitemap discovery — weekly Sunday 3 AM (find new feeds for shops without sitemap)
0 3 * * 0 flock -n /tmp/sitemap_discovery.lock python /app/jobs/sitemap_discovery.py --limit 200 >> /proc/1/fd/1 2>&1

# ── DISABLED (waiting for setup) ───────────────────────────────────
# Affiliate XML feeds — aktivovat po Awin/CJ registraci
# 0 */4 * * * python /app/jobs/affiliate_feeds.py >> /proc/1/fd/1 2>&1

# ── OBSERVABILITY ──────────────────────────────────────────────────
# Langfuse → Neon cost exporter — every 15 min, exports last 2h of AI cost data
*/15 * * * * flock -n /tmp/langfuse_exporter.lock python /app/jobs/langfuse_exporter.py --hours 2 >> /proc/1/fd/1 2>&1

# ── MAINTENANCE ────────────────────────────────────────────────────
# Redis backup — daily RDB snapshot
0 1 * * * redis-cli -a "${REDIS_PASSWORD:-notino-queue-2026}" -h redis BGSAVE >> /proc/1/fd/1 2>&1

# Cleanup cache (>7 days)
0 2 * * * find /app/cache -mtime +7 -delete >> /proc/1/fd/1 2>&1
